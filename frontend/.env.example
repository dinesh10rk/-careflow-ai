# CareFlow AI frontend configuration.
# These values are PUBLIC (they are bundled into the browser build).
# Never put API keys or secrets in this file.

# Base URL of the FastAPI backend
VITE_API_BASE_URL=http://127.0.0.1:8000

# "mock" = fictional demo data stored in this browser (works with no backend)
# "api"  = use the FastAPI backend for everything
VITE_DATA_SOURCE=mock
