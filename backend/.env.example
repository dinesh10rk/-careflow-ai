# CareFlow AI backend configuration
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the real .env file.

# --- MongoDB Atlas ---
# Paste your Atlas connection string here (URL-encode special characters in the password).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB_NAME=careflow_ai

# --- AI ---
# auto = live if OPENAI_API_KEY is set, otherwise demo
# demo = always use clearly labelled sample outputs
# live = require OPENAI_API_KEY (fails loudly if missing)
AI_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
# Comma-separated list of allowed frontend origins (no wildcard).
CORS_ORIGINS=http://localhost:5173

# --- App ---
APP_ENV=development
